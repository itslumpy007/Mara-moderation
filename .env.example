DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
# Railway: mount a persistent volume at /data and set DATA_DIR=/data
DATA_DIR=./data
# All channel/role IDs must belong to GUILD_ID.
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
VERIFIED_ROLE_ID=
STAFF_ROLE_ID=
TICKET_CATEGORY_ID=

# Optional AI. List channel IDs, use all for all eligible channels, or leave blank for staff commands only.
# Notify members before enabling. Never paste API keys in chat.
AI_ENABLED=false
OPENAI_API_KEY=
AI_CHANNEL_IDS=
# Set a Responses API text model available to your account for /ai-summary.
AI_MODEL=

# Optional web dashboard and CAPTCHA. Secrets belong in Railway Variables only.
DASHBOARD_ENABLED=false
PUBLIC_BASE_URL=
DISCORD_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Railway provides PORT automatically; no custom value is needed there.
